# ══════════════════════════════════════════════════════
# DocCompare — przykładowe zmienne środowiskowe
# Skopiuj do .env (NIE commituj .env do repozytorium!)
# ══════════════════════════════════════════════════════

# ── Bezpieczeństwo ─────────────────────────────────────
# Required: Flask session encryption key.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If not set, an ephemeral key is generated each restart (sessions won't persist).
SECRET_KEY=YOUR_SECRET_KEY_HERE

# ── Baza danych ────────────────────────────────────────
# Optional: PostgreSQL connection URL.
# Format: postgresql://user:password@host:port/dbname
# If not set, falls back to SQLITE_PATH (or instance/doccompare.db by default).
# Supabase: Settings → Database → Connection string (URI)
DATABASE_URL=YOUR_DATABASE_URL_HERE

# Optional: SQLite path for local dev (used when DATABASE_URL is empty).
# SQLITE_PATH=instance/doccompare.db

# ── Aplikacja ──────────────────────────────────────────
# Required for password reset emails and external links.
APP_BASE_URL=YOUR_APP_BASE_URL_HERE

# ── Email (Resend) ──────────────────────────────────────
# Optional: Transactional email via Resend (https://resend.com → API Keys → Create).
# If not set, password reset emails will not be sent.
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
EMAIL_FROM=YOUR_EMAIL_FROM_HERE

# ── AI (Claude / Anthropic) ─────────────────────────────
# Required for AI features (artwork comparison, document analysis, AI learning).
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Mistral OCR ─────────────────────────────────────────
# Optional: Primary OCR engine ($0.001/page). Falls back to Tesseract if not set.
# Get from: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE

# ── GLM-OCR (Zhipu) — opcjonalny silnik OCR do testów A/B ──────────────────────
# Endpoint przyjmujący {image_base64, task, prompt} i zwracający JSON z 'rows'
# (lista pozycji) albo tekst/markdown tabeli. Self-host modelu GLM-OCR (0.9B, MIT)
# lub bramka API. Bez GLM_OCR_URL silnik „GLM-OCR" w porównywarce jest nieaktywny.
GLM_OCR_URL=
# Opcjonalny token (nagłówek Authorization: Bearer ...).
GLM_OCR_API_KEY=YOUR_GLM_OCR_API_KEY_HERE

# ── Śledzenie kontenerów (opcjonalne) ──────────────────
# Optional: Container tracking API keys. Can also be set in the UI (Śledzenie → Konfiguracja API).
# SafeCube / Sinay (aggregator): app.safecube.ai/api/credentials
SAFECUBE_API_KEY=YOUR_SAFECUBE_API_KEY_HERE
# TrackCargo (aggregator): trackcargo.co/dashboard → API key
TRACKCARGO_API_KEY=YOUR_TRACKCARGO_API_KEY_HERE
# Maersk: developer.maersk.com → aplikacja → subskrypcja „Track & Trace" → Consumer-Key
MAERSK_CONSUMER_KEY=YOUR_MAERSK_CONSUMER_KEY_HERE
# 17track: api.17track.net
TRACK17_API_KEY=YOUR_TRACK17_API_KEY_HERE
# ShipsGo (aggregator, model kredytowy): shipsgo.com → sekcja API → authCode
SHIPSGO_API_KEY=YOUR_SHIPSGO_API_KEY_HERE

# ── Monitoring (Sentry) ────────────────────────────────
# Optional: Sentry error tracking DSN.
# Get from: https://sentry.io → Projects → Flask → DSN
# If not set, error tracking is disabled.
SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# ── Logi ───────────────────────────────────────────────
# Optional: Directory for log files (default: logs).
LOG_DIR=logs

# Optional: Log verbosity level (debug/info/warning/error, default: warning).
LOG_LEVEL=warning

# ── Gunicorn (produkcja) ───────────────────────────────
# Optional: Number of gunicorn worker processes (default: 2).
# Keep at 2 for 8 GB hosts — each worker loads CV models (~2 GB each).
WEB_CONCURRENCY=2

# Optional: Threads per gunicorn worker (default: 3).
# Threads share memory within a worker — good for I/O-bound Claude API waits.
THREADS_PER_WORKER=3

# ── Baza danych — pool ────────────────────────────────
# Optional: Max DB connection pool size (default: 10).
DB_POOL_SIZE=10

# ── Modele AI ─────────────────────────────────────────
# Optional: Set to 1 to disable Qwen2.5-VL model (~12 GB RAM).
# Disable on hosts with less than 16 GB RAM to prevent OOM kills.
DISABLE_QWEN=1

# ── Kolejkowanie zadań (Poziom 1 — opcjonalne) ────────
# Ustaw, aby ciężkie zadania (np. batch artworków) liczył osobny worker (worker.py)
# zamiast wątku w procesie web. Puste = fallback na wątki (dotychczasowe zachowanie).
# Przykład: redis://redis:6379/0
REDIS_URL=YOUR_REDIS_URL_HERE
# Optional: nazwa kolejki (domyślnie 'doccompare') i limit czasu na zadanie (s).
RQ_QUEUE=doccompare
RQ_JOB_TIMEOUT=1800

# artwork-engine — optional standalone service (Phase 4 MLSPLIT-02)
# Unset (default): artwork comparison (compare_artworks) runs in-process in the web/worker,
# same as today. Set to the internal artwork-engine service URL (e.g.
# http://artwork-engine:5001) to offload CV compute for compare_artworks off the web process;
# the client falls back to in-process compute on any error/timeout.
ARTWORK_ENGINE_URL=
